---
import HeroAtmosphere from '../components/HeroAtmosphere.astro';
import portrait from '../assets/home/me.png';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <HeroAtmosphere />
  <div class="hero-layout">
    <div class="hero-copy">
      <h1 id="hero-title">BACKEND<br /><span class="name">DEVELOPER</span></h1>
      <p class="hero-subtitle"><span>Autodidacta</span></p>
      <p class="hero-description">Especializado en diseñar e implementar la arquitectura<br />
        lógica, APIs y bases de datos que dan vida al sotware<br />
        Pasión por la automatización e Inteligencia Artificial</p>
      <div class="hero-actions">
        <a class="button primary-button" href="#proyectos"><span class="play-icon" aria-hidden="true"></span> Ver proyectos <span class="button-arrow" aria-hidden="true">↗</span></a>
        <a class="button secondary-button" href="https://github.com/The-DigitalFarmer" target="_blank" rel="noopener noreferrer"><span class="icon icon-social-github" aria-hidden="true"></span> GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <a class="explore-skills" href="#habilidades"><span aria-hidden="true">↓</span> Descubre mi stack <span class="explore-line" aria-hidden="true"></span></a>
    </div>
    <div class="profile-area">
      <div class="profile-frame">
        <span class="frame-corner top-left"></span><span class="frame-corner top-right"></span><span class="frame-corner bottom-left"></span><span class="frame-corner bottom-right"></span>
        <div class="profile-orbit" aria-hidden="true"></div>
        <div class="profile-bottom"><span class="profile-name">YERSON CABRERA LANDA</span></div>
      </div>
      <img class="characters" src={portrait.src} width="1254" height="1254" alt="Un aventurero con gorro blanco y espada dorada junto a su compañero, un perro naranja, en pixel art." fetchpriority="high" />
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  isolation: isolate;
  overflow: clip;
  display: grid;
  align-items: center;
  min-height: calc(105svh - var(--header-height) - var(--home-peek));
  border-bottom: 1px solid var(--frame-line);
  scroll-margin-top: var(--anchor-offset);
}

.hero-layout {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: clamp(24px, 3vw, 48px);
  width: min(var(--frame-width), calc(100% - 2 * var(--page-gutter)));
  margin-inline: auto;
  padding-block: 32px;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

h1 {
  font-family: system-ui, -apple-system, sans-serif;
  font-weight: 650;
  text-shadow: 4px 5px 0 #0808135c;
  font-size: clamp(42px, 4.5vw, 64px);
}

.name {
  color: var(--coral);
}

.hero-subtitle {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--mono);
  font-size: 25px;
  font-weight: 700;
  letter-spacing: -.8px;
  line-height: 1.5;
  margin: 0 0 16px;
}

.hero-subtitle span {
  color: var(--coral);
}

.hero-description {
  font-family: system-ui, -apple-system, sans-serif;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
  margin: 0 0 24px;
}

.profile-area {
  position: relative;
  isolation: isolate;
  height: clamp(340px, 48svh, 490px);
  margin-top: 0;
}

.profile-frame {
  position: absolute;
  inset: 23px 19px 17px 40px;
  background: linear-gradient(140deg,#ffffff04,#20132408);
  border: 1px solid #b4a0b438;
  box-shadow: inset 0 0 50px #4fc8ae05;
}

.frame-corner {
  width: 14px;
  height: 14px;
  position: absolute;
  border-color: #db9b9a;
  border-style: solid;
}

.top-left {
  left: -2px;
  top: -2px;
  border-width: 3px 0 0 3px;
}

.top-right {
  right: -2px;
  top: -2px;
  border-width: 3px 3px 0 0;
}

.bottom-left {
  left: -2px;
  bottom: -2px;
  border-width: 0 0 3px 3px;
}

.bottom-right {
  right: -2px;
  bottom: -2px;
  border-width: 0 3px 3px 0;
}

.profile-orbit {
  position: absolute;
  width: 250px;
  height: 250px;
  left: 50%;
  top: 48%;
  transform: translate(-50%,-50%);
  border: 1px solid #4fc8ae1a;
  clip-path: polygon(25% 0,75% 0,100% 25%,100% 75%,75% 100%,25% 100%,0 75%,0 25%);
  background: repeating-linear-gradient(0deg,transparent 0 24px,#4fc8ae08 24px 25px),
    repeating-linear-gradient(90deg,transparent 0 24px,#4fc8ae08 24px 25px);
}

.characters {
  position: absolute;
  height: auto;
  image-rendering: pixelated;
  filter: drop-shadow(0 15px 5px #0e0b2080);
  animation: float 6s ease-in-out infinite;
  z-index: 1;
  left: 50%;
  translate: -50% 0;
  width: min(100%, 48svh, 490px);
  top: 5px;
}

.profile-bottom {
  position: absolute;
  left: 0;
  right: 20px;
  bottom: 100%;
  margin-bottom: 10px;
}

.profile-name {
  font-size: 7px;
  color: #c696a7;
  letter-spacing: 2px;
}

@media (max-width: 1050px) {

  .profile-frame {
    inset: 25px 0 15px 15px;
  }

  .hero-subtitle {
    font-size: 22px;
  }
}

@media (max-width: 760px) {

  .hero-copy {
    width: min(100%, 470px);
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    margin-bottom: 20px;
  }

  .hero-subtitle {
    font-size: 23px;
  }

  .hero-description {
    max-width: 350px;
    margin-inline: auto;
  }

  .profile-area {
    height: 410px;
    margin: 14px auto 10px;
    width: min(100%,440px);
  }

  .profile-frame {
    inset: 17px 12px 23px 24px;
  }

  .profile-orbit {
    width: 220px;
    height: 220px;
  }

}

@media (max-width: 380px) {
  .profile-area {
    height: 365px;
  }

}

@media (max-width: 760px) {
  .profile-name {
    font-size: 6px;
    letter-spacing: 1px;
  }
}

.hero-actions {
  display: flex;
  align-items: stretch;
  gap: 17px;
  flex-wrap: wrap;
}

@media (max-width: 760px) {

  .hero-description {
    font-size: 11px;
  }

  .hero-actions {
    justify-content: center;
    gap: 13px;
  }
}

@media (max-width: 380px) {
  .hero-actions {
    gap: 12px;
  }

  .hero-description {
    font-size: 10px;
  }
}

.explore-skills {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: #bda0b2;
  font-size: 10px;
  letter-spacing: .5px;
  margin-top: 26px;
}

.explore-skills > span:first-child {
  color: var(--coral);
  font-size: 19px;
}

.explore-skills:hover {
  color: var(--cream);
}

.explore-line {
  display: block;
  width: 40px;
  height: 1px;
  background: #89566d;
}

@media (max-width: 760px) {
  .explore-skills {
    margin-top: 28px;
    font-size: 9px;
  }
}

@media (max-width: 760px) {
  .hero { min-height: auto; }
  .hero-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 44px 28px; }
  .characters { top: -30px; width: calc(100% + 16px); }
}

@media (min-width: 761px) and (max-height: 760px) {
  .hero-layout { padding-block: 20px; }
  h1 { margin-bottom: 16px; }
  .hero-subtitle { font-size: 20px; }
  .hero-description { font-size: 11px; margin-bottom: 18px; }
  .explore-skills { margin-top: 20px; }
}
</style>
