---
import { projects } from './data';
import ProjectCard from './ProjectCard.astro';
---

<section class="projects-section content-section section-surface" id="proyectos" aria-labelledby="projects-title">
  <p class="section-kicker">PROJECTS</p>
  <div class="section-header">
    <h2 class="content-title" id="projects-title">Projects in Production</h2>
    <a class="projects-all" href="https://github.com/The-DigitalFarmer?tab=repositories" target="_blank" rel="noopener noreferrer">Ver todos <span aria-hidden="true">→</span></a>
  </div>
  <div class="projects-grid">
    {projects.map(project => <ProjectCard project={project} />)}
  </div>
</section>
<style>
.projects-section {
  --border: #ffffff24;
  --copy: #a6a6a6;
  --projects-orange: #ff633f;
}

.section-kicker {
  margin-bottom: 12px;
  color: var(--projects-orange);
}

.section-header {
  align-items: baseline;
  margin-bottom: 28px;
}

.content-title {
  margin: 0;
  color: #f5f5f5;
  font-size: clamp(26px, 3vw, 36px);
  letter-spacing: -1.2px;
}

.projects-all {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10px;
  padding-block: 10px;
  color: var(--copy);
  font: 12px/1.6 var(--mono);
  transition: color .2s;
}

.projects-all:hover {
  color: var(--projects-orange);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-top: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

@media (max-width: 800px) {
  .projects-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
