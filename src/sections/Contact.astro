---
import adventurers from '../assets/contact/adventurers.png';
---

<section class="contact-section section-surface" id="contacto" aria-labelledby="contact-title">
            <p class="section-kicker">CONTACT</p>
            <div class="contact-layout">
                <div class="contact-scene">
                    <div class="contact-speech" aria-hidden="true">Convirtiendo cafeína<br>en código<span>!</span></div>
                    <div class="contact-portal" aria-hidden="true"><div class="portal-grid"></div><span class="portal-star">✦</span></div>
                    <span class="contact-spark spark-a" aria-hidden="true">✦</span><span class="contact-spark spark-b" aria-hidden="true">+</span><span class="contact-spark spark-c" aria-hidden="true">·</span>
                    <div class="contact-ground" aria-hidden="true"></div>
                    <img class="contact-characters" src={adventurers.src} width="1584" height="993" alt="Los dos aventureros pixel art, listos para emprender una nueva misión contigo." loading="lazy">
                    <div class="contact-party" aria-hidden="true"><span class="party-pixels"><i></i><i></i><i></i></span></div>
                </div>
                <div class="contact-copy">
                    <p class="contact-invitation"><span aria-hidden="true"></span> LAS GRANDES IDEAS EMPIEZAN CON UN HOLA</p>
                    <h2 class="section-title" id="contact-title"><br><span>NETWORKING</span></h2>
                    <p class="contact-description">¿Tienes un proyecto en mente o un reto por resolver? Hablemos de cómo puedo aportar desde el backend.</p>
                    <div class="contact-channels" aria-label="Canales de contacto">
                        <a class="contact-channel contact-channel--gmail" href="mailto:cabreralandayersondimer@gmail.com" target="_blank" rel="noopener noreferrer" aria-label="Escribir a Yerson en Gmail">
                            <span class="channel-top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3Zm0 1 9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="miter"/></svg>
                                <span aria-hidden="true">↗</span></span><strong>Gmail</strong><span class="channel-caption">Escríbeme</span>
                        </a>
                        <a class="contact-channel" href="https://wa.me/51980822924?text=Hola+Yerson%2C+vi+tu+portafolio+y+me+gustar%C3%ADa+conversar+sobre+una+idea." target="_blank" rel="noopener noreferrer" aria-label="Conversar con Yerson en WhatsApp">
                            <span class="channel-top">
                                <span class="icon icon-social-whatsapp" aria-hidden="true"></span>
                            <span aria-hidden="true">↗</span></span><strong>WhatsApp</strong><span class="channel-caption">Conversemos</span>
                        </a>
                        <a class="contact-channel" href="https://www.linkedin.com/in/yerson-cabrera-88439b401/" target="_blank" rel="noopener noreferrer" aria-label="Ver el perfil de Yerson en LinkedIn">
                            <span class="channel-top">
                                <span class="icon icon-social-linkedin" aria-hidden="true"></span>
                            <span aria-hidden="true">↗</span></span><strong>LinkedIn</strong><span class="channel-caption">Conectemos</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

<style>
/* CONTACTO */

.contact-section {
  --ink: #1a1218;
  padding: 72px var(--section-gutter) 0;
  scroll-margin-top: var(--anchor-offset);
}

.contact-layout {
  display: grid;
  grid-template-columns: minmax(0,1.06fr) minmax(0,.94fr);
  gap: 58px;
  align-items: center;
  padding: 10px 0 45px;
  min-height: 546px;
}

.contact-scene {
  order: 2;
  position: relative;
  height: 470px;
  min-width: 0;
  isolation: isolate;
}

.contact-portal {
  position: absolute;
  width: 70%;
  height: 340px;
  left: 15%;
  top: 61px;
  clip-path: polygon(
    18% 0,
    82% 0,
    82% 4%,
    91% 4%,
    91% 12%,
    96% 12%,
    96% 22%,
    100% 22%,
    100% 100%,
    0 100%,
    0 22%,
    4% 22%,
    4% 12%,
    9% 12%,
    9% 4%,
    18% 4%
  );
  background: linear-gradient(180deg,#d9839666,#a95c7c22 75%,#4c284b00);
}

.contact-portal:before {
  content: '';
  position: absolute;
  inset: 3px;
  background: linear-gradient(180deg,#351a36,#2f182f77 80%,#120e2000);
  clip-path: inherit;
}

.portal-grid {
  position: absolute;
  inset: 10px 7px 0;
  opacity: .55;
  background: repeating-linear-gradient(0deg,transparent 0 29px,#d98d9e17 29px 30px),
    repeating-linear-gradient(90deg,transparent 0 29px,#d98d9e17 29px 30px);
  mask-image: linear-gradient(transparent,#000 20%,#000 75%,transparent);
}

.portal-star {
  position: absolute;
  left: 50%;
  top: 47px;
  transform: translateX(-50%);
  font-size: 35px;
  color: #f2b294;
  filter: drop-shadow(0 0 18px #ff897d55);
}

.contact-speech {
  position: absolute;
  left: 1%;
  top: 14px;
  z-index: 3;
  border: 1px solid #9a657b;
  background: #22162b;
  box-shadow: 4px 4px 0 #0b09166b;
  padding: 15px 17px;
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 7px;
  line-height: 2;
  color: #e9c9ca;
  letter-spacing: .3px;
  transform: rotate(-3deg);
}

.contact-speech:after {
  content: '';
  position: absolute;
  bottom: -8px;
  right: 22px;
  width: 14px;
  height: 14px;
  transform: rotate(45deg);
  background: #22162b;
  border-right: 1px solid #9a657b;
  border-bottom: 1px solid #9a657b;
}

.contact-speech > span {
  position: absolute;
  right: -20px;
  top: -18px;
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  background: var(--coral);
  color: #241525;
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 13px;
  box-shadow: 3px 3px 0 #723c54;
}

.contact-characters {
  position: absolute;
  z-index: 2;
  width: calc(100% + 56px);
  height: auto;
  left: -28px;
  bottom: 56px;
  image-rendering: pixelated;
  filter: drop-shadow(0 15px 6px #09071180);
  animation: float 6s ease-in-out infinite;
}

.contact-ground {
  position: absolute;
  bottom: 51px;
  left: 3%;
  width: 94%;
  height: 50px;
  clip-path: polygon(
    8% 0,
    92% 0,
    92% 12%,
    100% 12%,
    100% 54%,
    94% 54%,
    94% 78%,
    84% 78%,
    84% 100%,
    16% 100%,
    16% 78%,
    6% 78%,
    6% 54%,
    0 54%,
    0 12%,
    8% 12%
  );
  background: repeating-linear-gradient(90deg,#70506400 0 27px,#d1869522 27px 30px),
    linear-gradient(#a9607977 0 5px,#4b2645 5px 19px,#321d35 19px 35px,#1b1326 35px);
}

.contact-spark {
  position: absolute;
  color: #d8a3ab;
  z-index: 1;
  text-shadow: 0 0 18px #ff897d44;
}

.spark-a {
  right: 8%;
  top: 42px;
  font-size: 22px;
}

.spark-b {
  left: 0;
  top: 43%;
  font-size: 23px;
}

.spark-c {
  right: 0;
  top: 47%;
  font-size: 40px;
  color: var(--coral);
}

.contact-party {
  position: absolute;
  left: 5%;
  right: 5%;
  bottom: 8px;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 6px;
  letter-spacing: .5px;
  color: #b998ae;
  line-height: 1.8;
}

.contact-party > span:last-child {
  margin-left: auto;
  color: #d5a3b0;
  font-size: 6px;
  letter-spacing: .5px;
}

.party-pixels {
  display: flex;
  gap: 3px;
}

.party-pixels > i {
  width: 4px;
  height: 4px;
  background: var(--coral);
}

.party-pixels > i:last-child {
  background: none;
  border: 1px solid var(--coral);
}

.contact-copy {
  order: 1;
  position: relative;
  min-width: 0;
  container-type: inline-size;
}

.contact-invitation {
  display: flex;
  gap: 9px;
  align-items: center;
  color: #f5f5f5;
  font-size: 9px;
  letter-spacing: .8px;
  line-height: 1.8;
  margin: 0 0 23px;
}

.contact-invitation > span {
  height: 5px;
  width: 5px;
  flex-shrink: 0;
  background: var(--coral);
  box-shadow: 0 0 11px #ff897d44;
}

.contact-copy h2 {
  overflow-wrap: anywhere;
  margin: 0 0 24px;
  text-shadow: 3px 4px 0 #08081355;
}

.contact-copy h2 > span {
  color: var(--focus-orange);
}

.contact-description {
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 18px;
  line-height: 1.8;
  color: var(--muted);
  margin: 0 0 28px;
  text-align: start;
  text-wrap: balance;
}

.contact-channels {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 13px;
}

.contact-channel {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 17px 16px;
  border: 1px solid #8b5d78;
  background: #24182c99;
  box-shadow: 4px 4px 0 #08081366;
  transition: background .2s,border-color .2s,transform .2s;
}

.channel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 9px;
  margin-bottom: 7px;
}

.channel-top > svg {
  width: 24px;
  height: 24px;
}

.channel-top > span {
  font-size: 19px;
  line-height: 1;
  opacity: .75;
}

.contact-channel > strong {
  font-size: 11px;
  letter-spacing: .2px;
  line-height: 1.5;
  color: #ead6df;
}

.channel-caption {
  font-size: 7px;
  line-height: 1.7;
  color: #b998ae;
}

.contact-channel--gmail {
  background: var(--coral);
  border-color: var(--coral);
  box-shadow: 4px 4px 0 #883b56;
}

.contact-channel--gmail .channel-top,
.contact-channel--gmail > strong {
  color: #241525;
}

.contact-channel--gmail .channel-caption {
  color: #64364a;
}

.contact-channel:hover {
  transform: translateY(-4px);
  background: #3b1e35;
  border-color: var(--coral);
}

.contact-channel--gmail:hover {
  background: #ffad91;
  border-color: #ffad91;
}

.contact-channel:active {
  transform: translateY(-1px);
}

@media (max-width: 1100px) {
  .contact-layout {
    gap: 35px;
    grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr);
  }

  .contact-scene {
    height: 430px;
  }

  .contact-portal {
    height: 300px;
    top: 66px;
  }

  .contact-characters {
    bottom: 62px;
    width: calc(100% + 50px);
    left: -25px;
  }

  .contact-ground {
    bottom: 55px;
  }

  .contact-speech {
    font-size: 6px;
    left: 0;
  }

  .contact-invitation {
    font-size: 8px;
    letter-spacing: .5px;
  }

  .contact-description {
    font-size: 15px;
  }

  .contact-channel {
    padding: 15px 12px;
  }

  .contact-channels {
    gap: 10px;
  }

  .channel-caption {
    font-size: 6px;
  }

  .contact-party {
    font-size: 5px;
    gap: 6px;
    letter-spacing: 0;
  }

  .contact-party > span:last-child {
    font-size: 5px;
  }
}

@media (max-width: 900px) and (min-width: 761px) {
  .contact-layout {
    gap: 24px;
  }

  .contact-speech {
    font-size: 5px;
    padding: 14px 12px;
  }

  .contact-portal {
    width: 80%;
    left: 10%;
  }

  .contact-channel {
    padding: 14px 9px;
  }

  .contact-channel > strong {
    font-size: 10px;
  }

  .contact-channels {
    gap: 8px;
  }

  .contact-party {
    left: 0;
    right: 0;
  }
}

@media (max-width: 760px) {
  .contact-section {
    padding-top: 55px;
  }

  .contact-layout {
    grid-template-columns: minmax(0,1fr);
    gap: 32px;
    min-height: 0;
    padding: 0 0 35px;
  }

  .contact-copy {
    order: 1;
  }

  .contact-scene {
    order: 2;
    width: min(100%,440px);
    height: 415px;
    margin: 0 auto;
  }

  .contact-copy h2 {
    margin-bottom: 20px;
  }

  .contact-invitation {
    font-size: 8px;
    letter-spacing: .6px;
    max-width: 100%;
    margin-bottom: 19px;
  }

  .contact-description {
    font-size: 14px;
    margin-bottom: 24px;
    text-align: start;
    text-wrap: wrap;
  }

  .contact-channels {
    gap: 12px;
  }

  .contact-channel {
    padding: 17px 14px;
    gap: 7px;
  }

  .contact-channel > strong {
    font-size: 11px;
  }

  .channel-caption {
    font-size: 7px;
  }

  .channel-top {
    margin-bottom: 6px;
  }

  .contact-speech {
    font-size: 6px;
    left: 5%;
    top: 14px;
  }

  .contact-portal {
    width: 70%;
    left: 15%;
    top: 61px;
    height: 300px;
  }

  .contact-characters {
    width: calc(100% + 20px);
    left: -10px;
    bottom: 58px;
  }

  .contact-ground {
    bottom: 51px;
  }

  .contact-party {
    font-size: 6px;
    gap: 8px;
    letter-spacing: .2px;
  }

  .contact-party > span:last-child {
    font-size: 6px;
  }
}

@media (max-width: 480px) {
  .contact-scene {
    height: 360px;
  }

  .contact-portal {
    height: 252px;
    top: 52px;
  }

  .contact-characters {
    bottom: 53px;
  }

  .contact-ground {
    bottom: 47px;
    height: 40px;
  }

  .contact-speech {
    left: 3%;
    font-size: 5px;
    padding: 13px 14px;
  }

  .contact-speech > span {
    width: 24px;
    height: 24px;
    right: -17px;
    top: -14px;
    font-size: 11px;
  }

  .portal-star {
    font-size: 27px;
    top: 36px;
  }

  .contact-party,
  .contact-party > span:last-child {
    font-size: 5px;
  }

  .contact-invitation {
    font-size: 7px;
    letter-spacing: .4px;
  }

  .contact-channels {
    gap: 9px;
  }

  .contact-channel {
    padding: 15px 11px;
  }

  .contact-channel > strong {
    font-size: 10px;
  }

  .channel-caption {
    font-size: 6px;
  }

  .channel-top > svg {
    width: 22px;
    height: 22px;
  }

  .contact-description {
    font-size: 14px;
  }
}

@media (max-width: 380px) {
  .contact-channel {
    padding: 13px 9px;
  }

  .contact-channels {
    gap: 8px;
  }

  .contact-channel > strong {
    font-size: 9px;
  }

  .channel-caption {
    font-size: 5px;
  }

  .contact-scene {
    height: 330px;
  }

  .contact-portal {
    height: 230px;
    top: 51px;
  }

  .contact-party {
    left: 1%;
    right: 1%;
  }
}
</style>
