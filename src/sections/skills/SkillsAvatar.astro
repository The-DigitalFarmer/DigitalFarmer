---
import avatarUrl from '@/assets/svg/avatar.svg?url';
---

<img
  class="skills-avatar"
  src={avatarUrl}
  alt="Personaje crema con cuernos curvos y ojos negros."
  width="1000"
  height="1195"
  loading="lazy"
  decoding="async"
/>

<style>
.skills-avatar {
  display: block;
  width: 160px;
  height: auto;
}
</style>
