---
import gilfoyleUrl from '@/assets/svg/gilfoyle.svg?url';
---

<img
  class="gilfoyle"
  src={gilfoyleUrl}
  alt="Gilfoyle con gafas y cabello largo."
  width="256"
  height="256"
  loading="lazy"
  decoding="async"
/>

<style>
.gilfoyle {
  display: block;
  width: 160px;
  height: auto;
}
</style>
