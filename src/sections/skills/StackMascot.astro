---
import mascotUrl from '@/assets/gilfoyle.svg?url';
---

<img
  class="stack-mascot"
  src={mascotUrl}
  alt="Gilfoyle con gafas y cabello largo."
  width="256"
  height="256"
  loading="lazy"
  decoding="async"
/>

<style>
.stack-mascot {
  display: block;
  width: 160px;
  height: auto;
}
</style>
