---
import mascotUrl from '@/assets/stack-mascot.svg?url';
---

<img
  class="stack-mascot"
  src={mascotUrl}
  alt="Ornitorrinco verde turquesa con expresión seria y gorra CABRERA de lado."
  width="256"
  height="256"
  loading="lazy"
  decoding="async"
/>

<style>
.stack-mascot {
  display: block;
  width: 160px;
  height: auto;
}
</style>
