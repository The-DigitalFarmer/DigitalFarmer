---
import { renderAsciiArches } from './ascii';
---

<div class="hero-atmosphere" aria-hidden="true">
  <pre class="atmosphere-ascii atmosphere-ascii--desktop">{renderAsciiArches()}</pre>
  <pre class="atmosphere-ascii atmosphere-ascii--mobile">{renderAsciiArches(0, true)}</pre>
  <div class="atmosphere-vignette"></div>
</div>

<script>
  import './atmosphere';
</script>

<style>
.hero-atmosphere {
  --atmosphere-accent: var(--focus-orange);
  --atmosphere-dot: color-mix(in srgb, var(--focus-orange) 20%, transparent);
  --atmosphere-glow: color-mix(in srgb, var(--focus-orange) 8%, transparent);
  --dot-spacing: 28px;
  --glow-x: calc(50% + min(25vw, 265px));
  position: absolute;
  inset: 0 0 auto;
  height: 50%;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
  background: var(--ink);
}

.hero-atmosphere::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle, var(--atmosphere-dot) 1px, transparent 1.5px) center top / var(--dot-spacing) var(--dot-spacing),
    radial-gradient(ellipse 580px 400px at var(--glow-x) 48%, var(--atmosphere-glow), transparent 78%);
  mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  animation: atmosphere-dots 8s linear infinite;
}

@keyframes atmosphere-dots {
  to { background-position: center var(--dot-spacing), center; }
}

.atmosphere-ascii {
  position: absolute;
  top: -40px;
  left: 50%;
  width: max-content;
  margin: 0;
  transform: translateX(-50%);
  color: var(--atmosphere-accent);
  font-family: var(--mono);
  font-size: clamp(10px, .8vw, 14px);
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: 0;
  white-space: pre;
  opacity: .6;
  user-select: none;
  mask-image: linear-gradient(180deg, transparent, #000 12%, #000 42%, transparent 92%);
}

.atmosphere-ascii--mobile {
  display: none;
}

.atmosphere-vignette {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 65%, var(--ink) 100%),
    radial-gradient(ellipse 440px 220px at 32% 52%, #080808b3, transparent 100%),
    linear-gradient(90deg, var(--ink), transparent 8%, transparent 92%, var(--ink));
}

.hero-atmosphere::after {
  content: '';
  position: absolute;
  inset: 0;
  background: url('../../assets/home-grain.svg') repeat;
  background-size: 180px 180px;
  opacity: .055;
  mix-blend-mode: soft-light;
}

@media (max-width: 760px) {
  .hero-atmosphere {
    --dot-spacing: 24px;
  }

  .hero-atmosphere::before {
    background:
      radial-gradient(circle, var(--atmosphere-dot) 1px, transparent 1.5px) center top / var(--dot-spacing) var(--dot-spacing),
      radial-gradient(ellipse 300px 380px at 50% 70%, var(--atmosphere-glow), transparent 80%);
  }

  .atmosphere-ascii--desktop {
    display: none;
  }

  .atmosphere-ascii--mobile {
    display: block;
    top: 0;
    font-size: 1.8vw;
    line-height: 1.45;
    opacity: .6;
    mask-image: linear-gradient(180deg, transparent, #000 8%, #000 75%, transparent);
  }

  .atmosphere-vignette {
    background:
      linear-gradient(180deg, transparent 65%, var(--ink) 100%),
      radial-gradient(ellipse 230px 180px at 50% 45%, #08080866, transparent 100%);
  }

}
</style>
