---
import mascotUrl from '@/assets/stack-mascot.svg?url';
---

<header class="header">
  <div class="header-inner">
    <a class="brand" href="#inicio" aria-label="DigitalFarmer, inicio">
      <img src={mascotUrl} alt="" width="32" height="32" />
      <span>OrnitorCode</span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="main-navigation">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <nav id="main-navigation" aria-label="Navegación principal">
      <a class="nav-active" href="#inicio" aria-current="location">Home</a>
      <a href="#habilidades">Skills</a>
      <a href="#sobre-mi">About</a>
      <a href="#proyectos">Projects</a>
      <a href="#experiencia">Experience</a>
      <a href="#contacto">Contact</a>
    </nav>
  </div>
</header>

<script>
  import './navigation';
</script>

<style>
.header {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  height: var(--header-height);
  max-height: 60px;
  border-bottom: 1px solid var(--frame-line);
  backdrop-filter: blur(12px);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 24px;
  height: 100%;
  padding: 0 var(--page-gutter);
}

.brand {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 6px;
  color: #f5f5f5;
  font: 700 18px/1.1 Switzer, system-ui, sans-serif;
  letter-spacing: -.4px;
}

.brand img {
  display: block;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
}

.nav-toggle {
  display: none;
}

.header nav {
  display: flex;
  height: 44px;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  flex: 1 1 280px;
  gap: clamp(8px, 1.7vw, 28px);
  max-width: 550px;
  margin-left: auto;
  font: 400 14px/22px Switzer, system-ui, sans-serif;
  overflow-x: auto;
  scrollbar-width: none;
}

.header nav::-webkit-scrollbar {
  display: none;
}

.header nav a {
  flex-shrink: 0;
  padding-block: 7px;
  white-space: nowrap;
  transition: color .2s;
}

.header nav a:hover,
.header nav .nav-active {
  color: var(--focus-orange);
}

@media (max-width: 760px) {
  .header-inner {
    gap: 12px;
  }

  .header nav {
    display: none;
    position: absolute;
    inset: 100% 0 auto;
    height: auto;
    max-height: calc(100svh - var(--header-height));
    max-width: none;
    margin: 0;
    padding: 12px var(--page-gutter) 20px;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    overflow-y: auto;
    background: #080808f5;
    border-bottom: 1px solid var(--frame-line);
    font-size: 15px;
  }

  .header nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .nav-toggle {
    display: flex;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cream);
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: transform .2s;
  }

  .nav-toggle[aria-expanded='true'] + nav {
    display: flex;
  }

  .nav-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .brand img {
    width: 32px;
    height: 32px;
  }
}

</style>
