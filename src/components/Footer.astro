---
import { Image } from 'astro:assets';
import footerPlatypus from '../assets/footer/ornitorrinco-fondo-salvia.png';
import mascotUrl from '../assets/shared/stack-mascot.svg?url';

const year = new Date().getFullYear();
const sections = [
  { href: '#habilidades', label: 'Skills' },
  { href: '#sobre-mi', label: 'About' },
  { href: '#proyectos', label: 'Projects' },
  { href: '#experiencia', label: 'Experience' },
];
const channels = [
  { href: 'mailto:cabreralandayersondimer@gmail.com', label: 'Gmail' },
  { href: 'https://wa.me/51980822924', label: 'WhatsApp' },
  { href: 'https://www.linkedin.com/in/yerson-cabrera-88439b401/', label: 'LinkedIn' },
  { href: 'https://github.com/The-DigitalFarmer', label: 'GitHub' },
];
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="#inicio" aria-label="DigitalFarmer, inicio"><img src={mascotUrl} alt="" width="44" height="44" /><strong>DigitalFarmer<span>.</span></strong></a>
      <p>Python, APIs y automatización.<br />Ideas que se convierten en código.</p>
    </div>
    <nav class="footer-column" aria-label="Explorar el portafolio">
      <h3>EXPLORAR</h3>
      {sections.map(section => <a href={section.href}>{section.label}</a>)}
    </nav>
    <nav class="footer-column" aria-label="Canales de contacto">
      <h3>CONECTEMOS</h3>
      {channels.map(channel => <a href={channel.href} target={channel.href.startsWith('https:') ? '_blank' : undefined} rel={channel.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{channel.label}<span aria-hidden="true">↗</span></a>)}
    </nav>
  </div>
  <div class="footer-meta" id="footer-meta">
    <span class="footer-name">OrnitorCode Foundation</span>
    <span class="footer-copyright">© <span id="year">{year}</span></span>
    <a class="footer-back-top" href="#inicio">
      <Image class="footer-platypus" src={footerPlatypus} alt="" width={32} height={24} densities={[1, 2]} format="webp" loading="lazy" />
      <span>Volver al inicio <span aria-hidden="true">↑</span></span>
    </a>
  </div>
</footer>

<script>
  const year = document.querySelector<HTMLSpanElement>('#year');
  if (year) year.textContent = String(new Date().getFullYear());
</script>

<style>
.site-footer {
  background: #1a1218;
  color: var(--muted);
  font-family: system-ui, sans-serif;
}

.footer-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 1fr));
}

.footer-brand,
.footer-column {
  padding: 40px var(--section-gutter);
}

.footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  border-left: 1px solid var(--frame-line);
}

.footer-brand a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--cream);
}

.footer-brand img {
  flex-shrink: 0;
}

.footer-brand strong {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -.5px;
}

.footer-brand strong span {
  color: var(--coral);
}

.footer-brand p {
  margin: 24px 0 0;
  font-size: 13px;
  line-height: 1.9;
}

.footer-column h3 {
  margin: 0 0 10px;
  color: #bda1b4;
  font: 10px/1.8 var(--mono);
  letter-spacing: 1.3px;
}

.footer-column a {
  display: flex;
  gap: 10px;
  font-size: 14px;
}

.site-footer a:hover {
  color: var(--coral);
}

.footer-column a span {
  opacity: .5;
}

.footer-meta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 16px;
  padding: 22px var(--section-gutter);
  border-top: 1px solid var(--frame-line);
  font: 10px/1.8 var(--mono);
}

.footer-name {
  grid-column: 1;
  justify-self: start;
}

.footer-copyright {
  grid-column: 2;
  text-align: center;
}

.footer-meta a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.footer-back-top {
  grid-column: 3;
  justify-self: end;
  font: 400 12px/1 ui-monospace, 'SF Mono', 'Fira Code', 'JetBrains Mono', Menlo, monospace;
}

.footer-platypus {
  display: block;
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  border-radius: 2px;
  object-fit: cover;
}

@media (max-width: 700px) {
  .footer-meta {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .footer-name,
  .footer-copyright,
  .footer-back-top {
    grid-column: 1;
    justify-self: center;
  }

  .footer-name {
    justify-self: start;
  }

  .footer-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .footer-column {
    border-left: 0;
    border-top: 1px solid var(--frame-line);
  }
}
</style>
