---
import type { Project } from '../data/portfolio';
import ProjectPreview from './ProjectPreview.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card" aria-labelledby={project.id}>
  <ProjectPreview preview={project.preview} />
  <div class="project-copy">
    <p class="project-kind">{project.kind}</p>
    <h3 id={project.id}>
      {project.name}{project.suffix && <span>{project.suffix}</span>}
    </h3>
    <p class="body-copy">{project.description}</p>
    <div class="project-actions">
      {[
        { label: 'Repositorio', url: project.repositoryUrl },
        { label: 'Ver web', url: project.websiteUrl },
      ].map(({ label, url }) => (
        <a
          class="project-link"
          href={url || undefined}
          target={url ? '_blank' : undefined}
          rel={url ? 'noopener noreferrer' : undefined}
          role={url ? undefined : 'link'}
          aria-disabled={url ? undefined : 'true'}
          tabindex={url ? undefined : -1}
          aria-label={`${label} de ${project.name}${url ? '' : ' (enlace pendiente)'}`}
        >{label} <span aria-hidden="true">↗</span></a>
      ))}
    </div>
  </div>
</article>

<style>
.project-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  transition: background .2s;
  background: #1d161e;
}

.project-card:hover,
.project-card:focus-within {
  background: color-mix(in srgb, #1d161e 96%, var(--muted));
}

.project-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: clamp(24px, 2.5vw, 32px);
}

.project-kind {
  margin: 0 0 20px;
  color: var(--projects-orange);
  font: 10px/1.7 var(--mono);
  letter-spacing: .3px;
}

.project-copy h3 {
  margin: 0 0 20px;
  color: #f5f5f5;
  font-size: clamp(22px, 2vw, 26px);
  font-weight: 600;
  letter-spacing: -.6px;
  line-height: 1.35;
}

.body-copy {
  color: var(--copy);
  font-size: 15px;
  line-height: 1.8;
}

.project-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: auto;
  padding-top: 24px;
}

.project-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid #ffffff40;
  color: #f5f5f5;
  font: 11px/1.7 var(--mono);
  transition: color .2s, border-color .2s, background .2s;
}

.project-link[href]:hover {
  border-color: var(--projects-orange);
  background: #ff633f12;
  color: var(--projects-orange);
}

.project-link[aria-disabled="true"] {
  border-color: var(--border);
  color: var(--copy);
  cursor: default;
}
</style>
