---
import github from '@/assets/github.svg?url';
import linkedin from '@/assets/linkedin.svg?url';
import whatsapp from '@/assets/whatsapp.svg?url';

interface Props {
  name: 'github' | 'linkedin' | 'whatsapp';
}

const { name } = Astro.props;
const logos = { github, linkedin, whatsapp };
---

<img class="social-logo" src={logos[name]} alt="" aria-hidden="true" width="24" height="24" decoding="async" />

<style>
.social-logo {
  display: block;
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  object-fit: contain;
}
</style>
